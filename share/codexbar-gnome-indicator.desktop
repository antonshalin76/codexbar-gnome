[Desktop Entry]
Type=Application
Name=CodexBar GNOME Indicator
Comment=Show Codex, Grok, Claude, and Antigravity usage limits in the GNOME top bar
Exec=/bin/sh -c "exec ~/.local/bin/codexbar-gnome-indicator"
Icon=utilities-system-monitor
Terminal=false
X-GNOME-Autostart-enabled=true
Categories=Utility;
