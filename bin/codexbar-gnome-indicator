#!/usr/bin/env python3
"""GNOME AppIndicator front end for CodexBar usage providers."""

from __future__ import annotations

import copy
import ctypes
import json
import math
import os
import re
import selectors
import shutil
import signal
import stat
import subprocess
import sys
import threading
import time
from collections.abc import Callable
from dataclasses import dataclass, field, replace
from datetime import datetime
from decimal import ROUND_HALF_UP, Decimal, InvalidOperation
from pathlib import Path
from urllib.parse import unquote, urlsplit

MAX_CHILD_ENV_BYTES = 128 * 1024
_CREDENTIAL_ENV_KEY = re.compile(
    r"(?i)(?:api_?key|access_?token|auth_?token|token|secret|password|passwd|"
    r"(?:^|_)pwd(?:$|_)|private_?key|credential|cookie|auth|session)"
)
_CREDENTIAL_CONTAINER_KEY = re.compile(r"(?i)(?:^|_)(?:url|uri|dsn)(?:$|_)")
_EMBEDDED_CREDENTIAL = re.compile(
    r"""(?ix)(?:password|passwd|token|secret|api[_-]?key|auth|private[_-]?key)
    ["']?\s*[=:]\s*["']?([^"'\s;,}]+)"""
)


def _credential_values(environment: dict[str, str]) -> tuple[str, ...]:
    secrets: list[str] = []
    for key, value in environment.items():
        if not value:
            continue
        if _CREDENTIAL_ENV_KEY.search(key) or _CREDENTIAL_CONTAINER_KEY.search(key):
            secrets.append(value)
        try:
            parsed = urlsplit(value)
        except ValueError:
            parsed = None
        if parsed is not None and parsed.netloc:
            for credential in (parsed.username, parsed.password):
                if credential:
                    secrets.append(unquote(credential))
        secrets.extend(match.group(1) for match in _EMBEDDED_CREDENTIAL.finditer(value))
    return tuple(dict.fromkeys(secrets))


def _os_text_encodable(value: str) -> bool:
    try:
        os.fsencode(value)
    except UnicodeError:
        return False
    return True


def _signal_process_group(process_group: int, signum: int) -> None:
    try:
        os.killpg(process_group, signum)
    except OSError:
        pass


def _direct_child_pids(parent_pid: int) -> tuple[int, ...]:
    children: set[int] = set()
    try:
        tasks = tuple(Path(f"/proc/{parent_pid}/task").iterdir())
    except OSError:
        return ()
    for task in tasks:
        try:
            children.update(
                int(value) for value in (task / "children").read_text().split()
            )
        except (OSError, ValueError):
            continue
    return tuple(sorted(children))


def _descendant_pids(root_pid: int) -> tuple[int, ...]:
    descendants: list[int] = []
    pending = [root_pid]
    seen = {root_pid}
    while pending:
        parent = pending.pop()
        for child in _direct_child_pids(parent):
            if child in seen:
                continue
            seen.add(child)
            descendants.append(child)
            pending.append(child)
    return tuple(descendants)


def _adopted_child_pids() -> tuple[int, ...]:
    return _direct_child_pids(os.getpid())


def _stop_and_reap_adopted_children(signum: int, deadline: float) -> None:
    """Drain descendants that escaped the provider's original process group."""
    while True:
        while True:
            try:
                pid, _status = os.waitpid(-1, os.WNOHANG)
            except ChildProcessError:
                return
            if pid == 0:
                break
        for pid in _adopted_child_pids():
            try:
                os.kill(pid, signum)
            except OSError:
                pass
        if time.monotonic() >= deadline:
            return
        time.sleep(0.01)


def _read_child_environment(environment_fd: int) -> dict[str, str]:
    with os.fdopen(environment_fd, "rb", closefd=True) as stream:
        payload = stream.read(MAX_CHILD_ENV_BYTES + 1)
    if len(payload) > MAX_CHILD_ENV_BYTES:
        raise ValueError("provider environment payload is too large")
    decoded = json.loads(payload.decode("utf-8", errors="strict"))
    if not isinstance(decoded, dict):
        raise TypeError("provider environment payload must be an object")
    for key, value in decoded.items():
        if (
            not isinstance(key, str)
            or not key
            or "=" in key
            or "\x00" in key
            or not isinstance(value, str)
            or "\x00" in value
            or not _os_text_encodable(key)
            or not _os_text_encodable(value)
        ):
            raise ValueError("provider environment payload is invalid")
    return decoded


def _child_supervisor(
    argv: tuple[str, ...],
    expected_parent_pid: int,
    environment_fd: int | None = None,
) -> int:
    """Own and reap one provider process tree, including after parent death."""
    if not argv or expected_parent_pid <= 1 or not sys.platform.startswith("linux"):
        print("child supervisor requires Linux and a command", file=sys.stderr)
        return 64

    libc = ctypes.CDLL(None, use_errno=True)

    def wake_for_parent_check(_signum: int, _frame: object) -> None:
        pass

    signal.signal(signal.SIGCONT, wake_for_parent_check)
    if os.getppid() != expected_parent_pid:
        return 143
    if libc.prctl(36, 1, 0, 0, 0) != 0:  # PR_SET_CHILD_SUBREAPER
        print("unable to enable child subreaper", file=sys.stderr)
        return 70
    if libc.prctl(1, signal.SIGCONT, 0, 0, 0) != 0:  # PR_SET_PDEATHSIG
        print("unable to set parent-death signal", file=sys.stderr)
        return 70
    if os.getppid() != expected_parent_pid:
        return 143

    stopping = 0

    def request_stop(signum: int, _frame: object) -> None:
        nonlocal stopping
        stopping = signum

    for handled in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(handled, request_stop)

    child_environment: dict[str, str] | None = None
    if environment_fd is not None:
        try:
            child_environment = _read_child_environment(environment_fd)
        except (OSError, UnicodeError, ValueError, TypeError) as environment_error:
            print(
                "unable to load provider environment: "
                f"{type(environment_error).__name__}",
                file=sys.stderr,
            )
            return 64
        if os.getppid() != expected_parent_pid:
            return 143

    if os.getppid() != expected_parent_pid:
        return 143

    try:
        child = subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL,
            env=child_environment,
            start_new_session=True,
            close_fds=True,
        )
    except (OSError, UnicodeError, ValueError) as exc:
        print(f"unable to start provider: {type(exc).__name__}", file=sys.stderr)
        return 71

    status: int | None = None
    sent_term = False
    term_deadline = 0.0
    while status is None:
        if not stopping and os.getppid() != expected_parent_pid:
            stopping = signal.SIGTERM
        if stopping and not sent_term:
            _signal_process_group(child.pid, signal.SIGTERM)
            sent_term = True
            term_deadline = time.monotonic() + 0.5
        if sent_term and time.monotonic() >= term_deadline:
            _signal_process_group(child.pid, signal.SIGKILL)
        try:
            waited, raw_status = os.waitpid(child.pid, os.WNOHANG)
        except ChildProcessError:
            waited, raw_status = child.pid, 0
        if waited == child.pid:
            status = raw_status
            break
        time.sleep(0.01)

    _signal_process_group(child.pid, signal.SIGTERM)
    _stop_and_reap_adopted_children(signal.SIGTERM, time.monotonic() + 0.15)
    _signal_process_group(child.pid, signal.SIGKILL)
    _stop_and_reap_adopted_children(signal.SIGKILL, time.monotonic() + 1.0)

    if stopping:
        return 128 + stopping
    return os.waitstatus_to_exitcode(status)


# This branch must remain before importing GTK. Provider cleanup must work on a
# headless machine and when the desktop process is killed with SIGKILL.
if (
    len(sys.argv) >= 7
    and sys.argv[1] == "--child-supervisor-env-fd"
    and sys.argv[3] == "--expected-parent-pid"
    and sys.argv[5] == "--"
):
    try:
        _supervised_environment_fd = int(sys.argv[2])
        _supervised_parent_pid = int(sys.argv[4])
    except ValueError:
        raise SystemExit(64) from None
    raise SystemExit(
        _child_supervisor(
            tuple(sys.argv[6:]),
            _supervised_parent_pid,
            _supervised_environment_fd,
        )
    )
if (
    len(sys.argv) >= 6
    and sys.argv[1:3] == ["--child-supervisor", "--expected-parent-pid"]
    and sys.argv[4] == "--"
):
    try:
        _supervised_parent_pid = int(sys.argv[3])
    except ValueError:
        raise SystemExit(64) from None
    raise SystemExit(_child_supervisor(tuple(sys.argv[5:]), _supervised_parent_pid))


