APPLICATION_ID = "io.github.antonshalin76.CodexBarGnome"
INDICATOR_ID = "codexbar-gnome-indicator"
RUNTIMES = ("codex", "grok", "claude")
RUNTIME_LABELS = {"codex": "Codex", "grok": "Grok", "claude": "Claude"}
DEFAULT_REFRESH_SECONDS = 300
MIN_REFRESH_SECONDS = 30
MAX_REFRESH_SECONDS = 86400
MAX_LIMIT_ROWS = 8
MAX_USAGE_EXTRAS = 64
MAX_DETAILS_CHARS = 16 * 1024
MAX_CONFIG_BYTES = 64 * 1024
MAX_DIAGNOSTIC_CHARS = 512
MAX_DIAGNOSTIC_SCAN_CHARS = 4 * MAX_DIAGNOSTIC_CHARS
DEFAULT_SETTINGS = {
    "runtimes": {
        "codex": {"poll": True, "autoRefresh": True},
        "grok": {"poll": True, "autoRefresh": True},
        "claude": {"poll": False, "autoRefresh": False},
    }
}
FAIL_CLOSED_SETTINGS = {
    "runtimes": {runtime: {"poll": False, "autoRefresh": False} for runtime in RUNTIMES}
}


def _attempt(action: Callable[[], object]) -> Exception | None:
    try:
        action()
    except Exception as exc:  # noqa: BLE001 - used only at cleanup boundaries
        return exc
    return None


def sanitize_diagnostic(value: object, sensitive_values: tuple[str, ...] = ()) -> str:
    try:
        text = value if isinstance(value, str) else str(value)
    except Exception:  # noqa: BLE001 - diagnostics must never become a new failure
        text = type(value).__name__

    def normalize_controls(raw: str) -> str:
        raw = raw.encode("utf-8", errors="replace").decode("utf-8")
        controlled = "".join(
            " " if ord(char) < 32 or ord(char) == 127 else char for char in raw
        )
        return re.sub(r"\s+", " ", controlled).strip()

    secrets = tuple(
        secret for secret in sensitive_values if isinstance(secret, str) and secret
    )
    max_secret_length = min(
        max((len(secret) for secret in secrets), default=0), MAX_CHILD_ENV_BYTES
    )
    text = normalize_controls(text[: MAX_DIAGNOSTIC_SCAN_CHARS + max_secret_length])
    normalized_secrets = sorted(
        {normalize_controls(secret[:MAX_CHILD_ENV_BYTES]) for secret in secrets} - {""},
        key=len,
        reverse=True,
    )
    if normalized_secrets:
        secret_pattern = re.compile(
            "|".join(re.escape(secret) for secret in normalized_secrets)
        )
        text = secret_pattern.sub("[redacted]", text)
    text = text[:MAX_DIAGNOSTIC_SCAN_CHARS]
    text = re.sub(
        r"(?i)authorization\s*:\s*(?:bearer\s+)?[^;,]+",
        "Authorization: [redacted]",
        text,
    )
    credential_name = (
        r"[A-Za-z0-9_-]{0,64}(?:api[_-]?key|access[_-]?token|auth[_-]?token|"
        r"client[_-]?secret|password|passwd|token)"
    )
    text = re.sub(
        rf"(?i)([\"']?\b{credential_name}[\"']?\s*[:=]\s*)"
        r'(?:"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'|[^;,]+)',
        lambda match: match.group(1) + "[redacted]",
        text,
    )
    if len(text) > MAX_DIAGNOSTIC_CHARS:
        text = text[: MAX_DIAGNOSTIC_CHARS - 3] + "..."
    return text


def sanitize_failure_kind(value: object, sensitive_values: tuple[str, ...] = ()) -> str:
    if not isinstance(value, str):
        return "provider"
    kind = sanitize_diagnostic(value, sensitive_values)
    if re.fullmatch(r"[A-Za-z][A-Za-z0-9_.-]{0,63}", kind) is None:
        return "provider"
    return kind


_PROCESS_FAILURE_KINDS = frozenset(
    {
        "capability",
        "cancelled",
        "closed",
        "config",
        "configuration",
        "empty",
        "encoding",
        "exit",
        "io",
        "output_limit",
        "parse",
        "runtime",
        "schema",
        "spawn",
        "timeout",
    }
)


def _process_failure_kind(value: object, sensitive_values: tuple[str, ...] = ()) -> str:
    kind = sanitize_failure_kind(value, sensitive_values)
    return kind if kind in _PROCESS_FAILURE_KINDS else "provider"


def parse_refresh_seconds(
    raw: str | None, warning_sink: Callable[[str], object]
) -> int:
    if raw in (None, ""):
        return DEFAULT_REFRESH_SECONDS
    try:
        value = int(raw, 10)
        if str(value) != raw or not MIN_REFRESH_SECONDS <= value <= MAX_REFRESH_SECONDS:
            raise ValueError
    except (TypeError, ValueError, OverflowError):
        warning = sanitize_diagnostic(
            f"Invalid refresh interval; using default {DEFAULT_REFRESH_SECONDS}"
        )
        _attempt(lambda: warning_sink(warning))
        return DEFAULT_REFRESH_SECONDS
    return value


class SettingsFailure(Exception):
    def __init__(self, message: object) -> None:
        self.message = sanitize_diagnostic(message)
        super().__init__(self.message)


class ProcessFailure(Exception):
    def __init__(self, kind: str, sanitized_message: object) -> None:
        self.kind = kind
        self.sanitized_message = sanitize_diagnostic(sanitized_message)
        super().__init__(self.sanitized_message)


@dataclass(frozen=True)
class SettingsLoad:
    settings: dict[str, object]
    failure: SettingsFailure | None = None


@dataclass(frozen=True)
class ProcessRequest:
    runtime: str
    argv: tuple[str, ...]
    env_overrides: dict[str, str | None]
    timeout: float


@dataclass(frozen=True)
